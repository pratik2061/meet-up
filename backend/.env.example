PORT=port-address-here

NODE_ENV=stage-of-project (development/prodution)

DATABASE_URL="postgresql://db-username:db-password@localhost:5432/your-project-name?schema=public"

JWT_SECRET=your-own-secret-key-for-jwt-token
ACCESS_EXPIRES_IN=seconds-for-access-token-expiration // example: 900 for 15 minutes
REFRESH_EXPIRES_IN=seconds-for-refresh-token-expiration // example: 604800 for 7 days
