PORT=3000
NODE_ENV=development

# MongoDB (Local or Atlas)
MONGODB_URI=mongodb://your_username:your_password@127.0.0.1:27017/your_db_name?authSource=admin

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_TTL=3600

# JWT Secrets
ACCESS_SECRET=your_jwt_access_secret_min_32_characters
REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters
ACCESS_EXPIRES_IN=900
REFRESH_EXPIRES_IN=604800

# Docker MongoDB Credentials
MONGO_INITDB_ROOT_USERNAME=your_username
MONGO_INITDB_ROOT_PASSWORD=your_password

# Frontend Allowed Origin
FRONTEND_URL=http://localhost:5173

# Resend Email Service
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Cloudflare R2 / S3
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=meetup
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev

# LiveKit SFU Media Server
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://127.0.0.1:7880
